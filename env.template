# ExamCraft Platform Environment Configuration
# Copy this file to .env and update the values with your actual credentials

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/examcraft

# Authentication & Session
SESSION_SECRET=dev-secret-key-change-this-in-production

# OpenAI Configuration (for AI question generation and transcription)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google/Gemini AI Configuration (for proctoring analysis)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud Text-to-Speech Configuration
VITE_GOOGLE_TTS_API_KEY=your-google-tts-api-key-here

# SendGrid Email Configuration
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Application Configuration
NODE_ENV=development
PORT=5001

# Platform URLs
PLATFORM_URL=http://localhost:5001

# Replit Authentication (automatically provided by Replit)
# For local development, leave these empty
REPLIT_CLIENT_ID=
REPLIT_CLIENT_SECRET=

# File Upload Configuration
MAX_FILE_SIZE=50mb
UPLOAD_DIR=./uploads

# Email Configuration
FROM_EMAIL=support@withyoumna.com
FROM_NAME=ExamCraft Platform

# Security Configuration
BCRYPT_ROUNDS=12
JWT_SECRET=dev-jwt-secret-key-here

# Proctoring Configuration
VIDEO_CHUNK_DURATION=40000
MAX_VIOLATION_COUNT=10
ANALYSIS_CONFIDENCE_THRESHOLD=0.7

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
ENABLE_CONSOLE_LOGS=true

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_VIDEO_RECORDING=true
ENABLE_PROCTORING=true 